# Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit real keys to this file.

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# Server-only secret key (bypasses RLS). Do not expose to the client.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-secret-key

# Google Gemini (AI coaching / image analysis / encouragement)
GEMINI_API_KEY=your-gemini-api-key

# Firebase Admin (server-side push notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
